# ──────────────────────────────────────────────
# Xrexze — Environment Configuration Template
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Colab Backend (Primary) ──────────────────
# 1. Open Google Colab with a T4 GPU runtime
# 2. Run the colab/colab_server.py script
# 3. Copy the Cloudflare tunnel URL printed in the output
# 4. Paste it here:
COLAB_BASE_URL=https://your-tunnel-url.trycloudflare.com

# ── Legacy VLM API (optional fallback) ───────
# Only needed if NOT using the Colab backend.
VLM_API_BASE_URL=
VLM_API_KEYS=
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# ── Legacy OmniVoice (optional fallback) ─────
HF_OMNIVOICE_SPACE_ID=
HF_TOKEN=

# ── Narration Language ───────────────────────
NARRATION_LANGUAGE=hindi_devanagari

# ── Output Settings ──────────────────────────
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Video resolution
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# ── Performance Tuning ───────────────────────
MAX_RAM_USAGE_GB=6.0
API_RETRY_DELAY_SEC=5
API_MAX_RETRIES=3
VLM_TIMEOUT_SEC=120
VOICE_TIMEOUT_SEC=300
